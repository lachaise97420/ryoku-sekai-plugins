{
  "id": "sekai-usercard",
  "name": "Sekai User Card",
  "version": "0.2.0",
  "author": "Warren <warren@local>",
  "description": "SekaiPop's desktop user card: banner, greeting chip, avatar sticker, name, host, uptime, shell and desktop keys, today lane, avatar burst and hover tilt. Pick and frame the banner and avatar like SekaiPop.",
  "license": "MIT",
  "official": false,
  "hosts": ["desktopWidget"],
  "entryPoints": { "main": "service/Main.qml", "content": "content/Widget.qml" },
  "files": [
    "service/Framing.js",
    "content/UserCard.qml",
    "content/Pill.qml",
    "content/FramedImage.qml",
    "content/Framing.js",
    "content/ImageMath.js",
    "content/MaterialIcon.qml",
    "content/IconMap.js",
    "content/RoundClip.qml",
    "content/DotField.qml",
    "content/Slant.qml",
    "content/SekaiTheme.qml",
    "content/PicturesRow.qml",
    "content/PicturesPopup.qml",
    "content/FramerCard.qml",
    "content/FramerPopup.qml",
    "content/icons/outline/palette.svg",
    "content/icons/outline/trash-bin-minimalistic.svg",
    "content/icons/outline/gallery.svg",
    "content/icons/outline/crop.svg",
    "content/icons/outline/gallery-remove.svg",
    "content/icons/outline/user-circle.svg",
    "content/icons/outline/stars-minimalistic.svg",
    "content/icons/outline/add-circle.svg",
    "content/icons/outline/minus-circle.svg",
    "content/icons/outline/restart.svg",
    "content/icons/outline/check-circle.svg",
    "content/icons/bold/palette.svg",
    "content/icons/bold/trash-bin-minimalistic.svg",
    "content/icons/bold/gallery.svg",
    "content/icons/bold/crop.svg",
    "content/icons/bold/gallery-remove.svg",
    "content/icons/bold/user-circle.svg",
    "content/icons/bold/stars-minimalistic.svg",
    "content/icons/bold/add-circle.svg",
    "content/icons/bold/minus-circle.svg",
    "content/icons/bold/restart.svg",
    "content/icons/bold/check-circle.svg",
    "bin/usercard-state.sh",
    "bin/pick-image.sh",
    "bin/shrink-image.sh",
    "assets/preview-widget.png"
  ],
  "capabilities": { "densities": ["compact", "full"] },
  "defaults": { "host": "desktopWidget", "label": "Sekai User Card", "desktopWidget": { "bg": "none" } },
  "dependencies": {
    "commands": [
      "cat",
      "date",
      "mkdir",
      "mv",
      "printf",
      "rm",
      "sh",
      "uname",
      "xdg-user-dir",
      "ryoku-plugins-place",
      "magick",
      "convert",
      "identify",
      "ffmpeg",
      "ffprobe",
      "zenity",
      "kdialog",
      "yad"
    ]
  },
  "metadata": { "settings": [] }
}
